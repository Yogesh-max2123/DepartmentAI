# DepartmentAI (M.Tech.) environment variables
#
# Copy this file to ".env" and replace the placeholder values with
# your own credentials. Never commit the real ".env" file.

# PostgreSQL password for the local DepartmentAI database.
DEPARTMENTAI_DB_PASSWORD=your_database_password_here

# Google Gemini API key used for grounded answer generation.
GEMINI_API_KEY=your_api_key_here

# HTTP Basic Auth passwords for workflow portal accounts.
WORKFLOW_STUDENT_PASSWORD=Password@123
WORKFLOW_OFFICIAL_PASSWORD=Password@123
WORKFLOW_DMPC_PASSWORD=Password@123
